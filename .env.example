# Copy this file to .env and fill in real values before running.

# Get this from Neon (neon.tech) after creating a free project — it looks like:
# postgres://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Change this to your own admin password
ADMIN_PASSWORD=ats2026

# Change this to a long random string (see README for how to generate one)
JWT_SECRET=change-this-secret-in-production

PORT=3000

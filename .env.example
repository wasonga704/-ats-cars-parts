# Copy this file to .env and fill in real values before running.

# From Neon (neon.tech) — your database connection string
DATABASE_URL=

# Your own admin password
ADMIN_PASSWORD=ats2026

# A long random string — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-secret-in-production

PORT=3000

# --- Contact form email settings ---
# Your Gmail address (the account that will SEND the enquiry emails)
GMAIL_USER=

# A Gmail "App Password" (NOT your normal Gmail password) — see README for how to generate one
GMAIL_APP_PASSWORD=

# Where enquiries should be delivered to (defaults to josephwasonga40@gmail.com if left blank)
CONTACT_TO_EMAIL=josephwasonga40@gmail.com
